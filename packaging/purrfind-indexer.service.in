[Unit]
Description=PurrFind local file indexer
Documentation=https://github.com/guedessoftware/PurrFind
After=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=dbus
BusName=org.purrfind.Indexer
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/purrfind-indexer
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s
NoNewPrivileges=true
# This is a per-user unit.  Namespace/capability hardening options such as
# ProtectSystem, ProtectKernelModules and LockPersonality are only supported
# by privileged system managers on several Ubuntu systemd/kernel combinations
# and make the service exit with status 218/CAPABILITIES.  The indexer also
# needs to write its SQLite index below the user's XDG data directory.
ProtectHome=false
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=true
UMask=0077

[Install]
WantedBy=default.target
