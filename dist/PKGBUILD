# Maintainer: Guedes Software <guedessoftware@users.noreply.github.com>
pkgname=purrfind
pkgver=0.5.0rc2
pkgrel=25
pkgdesc='Fast, native file and content search for Linux'
arch=('x86_64')
url='https://github.com/guedessoftware/PurrFind'
license=('GPL-3.0-or-later')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'libx11' 'sqlite' 'poppler-qt6' 'libzip' 'libxml2' 'exiv2' 'tesseract' 'hicolor-icon-theme')
optdepends=('tesseract-data-eng: English OCR' 'tesseract-data-por: Portuguese OCR')
makedepends=('cmake' 'ninja')
source=("PurrFind-0.5.0-rc2-source.tar.xz")
sha256sums=('01216aa546c5587e1331954c83ad46e735d10a3aa9ab220e8d6e91774ca90c6f')
build() { cmake -S "PurrFind-0.5.0-rc2" -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr; cmake --build build; }
check() { QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure; }
package() { DESTDIR="$pkgdir" cmake --install build; }
